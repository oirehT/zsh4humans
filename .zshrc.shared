# Shared customizations for both macOS and PC

# Keep a large, shared history file in the default location so every shell
# instance reads from and appends to the same command log.
HISTFILE=~/.zsh_history
HISTSIZE=10000000
SAVEHIST=10000000

# Append commands instead of overwriting history on shell exit, merge commands
# from concurrent shells, keep timestamps, and avoid storing duplicate entries.
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_SAVE_NO_DUPS

# Initialize zoxide integration.
eval "$(zoxide init zsh)"

# Bind Ctrl+F to zoxide's interactive picker (only in interactive shells). It runs as a
# widget, like Ctrl+R, so it changes directory without typing 'zi' or adding it to history.
if [[ -o interactive ]]; then
  function z4h-zi() {
    local dir
    dir="$(zoxide query --interactive)" || { zle -R; return 0 }
    builtin cd -q -- "$dir" && -z4h-redraw-prompt
  }
  zle -N z4h-zi
  bindkey '^F' z4h-zi
fi
