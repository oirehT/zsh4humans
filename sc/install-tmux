#!/bin/sh
#
# Usage: install-tmux -d DIR [-q]
#
# Installs stock tmux from conda-forge to DIR. Pass -q to print nothing on success.
#
# The installation can be moved: shared libraries are found relative to the binary, and
# z4h makes terminfo available in ~/.terminfo before it starts tmux.

set -ue

dir=
quiet=
while getopts ':d:q' opt "$@"; do
  case "$opt" in
    d) dir=$OPTARG;;
    q) quiet=1;;
    *) >&2 echo 'Usage: install-tmux -d DIR [-q]'; exit 1;;
  esac
done

if [ -z "$dir" ] || [ "$OPTIND" -le $# ]; then
  >&2 echo 'Usage: install-tmux -d DIR [-q]'
  exit 1
fi

[ -n "$quiet" ] || printf '\033[33mz4h\033[0m: installing \033[32mtmux 3.8\033[0m to \033[4m%s\033[0m\n' "$dir"

sh -- "$(dirname -- "$0")"/install-conda "$dir" 'tmux==3.8_'
